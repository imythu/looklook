{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Looklook",
  "mainBinaryName": "looklook",
  "identifier": "com.looklook.client",
  "build": {},
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "Looklook",
    "category": "DeveloperTool",
    "shortDescription": "看看客户端：随时随地操作你的电脑和 AI 助手",
    "longDescription": "在自己的电脑上运行终端与 AI 助手，并通过看看服务端随时随地访问。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "packaging/nsis-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
